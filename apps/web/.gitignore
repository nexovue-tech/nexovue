# Logs. Anchored: an unanchored `logs` matches any directory of that name at any
# depth, which silently swallowed src/features/logs — untracked by git, and
# invisible to Tailwind's source detection, which reads .gitignore.
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
/dist
/dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
