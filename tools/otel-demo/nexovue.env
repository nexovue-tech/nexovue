# P1-62 — the variables that move the OpenTelemetry Demo's telemetry to us.
#
# Layered after the demo's own `.env` with a second `--env-file`, so only the
# overridden names appear here. Upstream derives every exporter endpoint from
# OTEL_COLLECTOR_HOST and the two ports, so these four lines redirect all of it.

# Our receiver's published ports, from the host's point of view. Containers on
# the demo's own bridge network reach the host through this name on Docker
# Desktop, which is where this gate has been run. Plain Linux Docker does not
# define it; there it needs `extra_hosts: host.docker.internal:host-gateway` on
# every demo service, which nothing here adds yet.
OTEL_COLLECTOR_HOST=host.docker.internal
OTEL_COLLECTOR_PORT_GRPC=14317
OTEL_COLLECTOR_PORT_HTTP=14318
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:14317

# Pinned so the gate measures the same demo twice. Upstream's own default is
# `latest`, which is a moving target.
DEMO_VERSION=3.0.0

# The browser's own endpoint is no longer blanked, and it is no longer set here:
# it needs the site key interpolated into it, and compose only guarantees `${...}`
# expansion inside a compose file. It is set on `frontend` in
# compose.nexovue.yaml, which explains why it points at the browser door.

# Only a fallback. The load generator's entrypoint asks flagd for the
# `loadGeneratorVUs` feature flag first and reads this variable only when flagd
# does not answer, so the run sits at the flag's value — 5 — unless the flag is
# changed. Measured: 5 users cost 1641 MiB across the whole demo, so there is no
# reason to fight the flag. To go lower, edit `loadGeneratorVUs` in the upstream
# clone's src/flagd/demo.flagd.json.
LOAD_GENERATOR_VUS=3
