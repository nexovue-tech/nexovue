# P1-62 — the demo's nginx (`image-provider`), pointed at our receiver *with a key*.
#
# A verbatim copy of upstream `src/image-provider/nginx.conf.template` at tag
# 3.0.0, plus one line: the `header` directive inside `otel_exporter`. nginx's
# OTLP exporter is configured here and not from OTEL_EXPORTER_OTLP_HEADERS, so
# without this line every span it exports is refused 401 at our door.
#
# `header name value;` inside `otel_exporter` exists since ngx_otel_module
# 0.1.2 — https://nginx.org/en/docs/ngx_otel_module.html
#
# ${NEXOVUE_INGEST_KEY} is substituted by the `command:` override in
# compose.nexovue.yaml, which also names it to envsubst. That override drops
# upstream's `cat /etc/nginx/nginx.conf`, which would print the key to the
# container log.
#
# Re-check this file against the clone whenever UPSTREAM_REF moves.

load_module modules/ngx_otel_module.so;

pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    otel_exporter {
        endpoint ${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT_GRPC};
        header x-nexovue-key ${NEXOVUE_INGEST_KEY};
    }
    otel_trace on;
    otel_trace_context propagate;
    otel_service_name ${OTEL_SERVICE_NAME};
    otel_span_name image-provider;


    include mime.types;
    sendfile on;
    server {
        listen ${IMAGE_PROVIDER_PORT};
        listen [::]:${IMAGE_PROVIDER_PORT};

        resolver 127.0.0.11;
        autoindex off;

        server_name _;
        server_tokens off;

        root /static;
        gzip_static on;

        location /status {
            stub_status on;
            access_log  on;
            allow all;
        }
    }
}
