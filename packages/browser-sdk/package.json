{
  "name": "@nexovue/browser-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real user monitoring for the nexovue browser door: web vitals, JS errors, page views and sessions.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.dts.json",
    "typecheck": "tsc -b",
    "size": "node scripts/measure-size.js",
    "test": "vitest run && pnpm run build && pnpm run size"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "web-vitals": "6.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
