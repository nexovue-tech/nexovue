{
  "name": "@nexovue/browser-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real user monitoring for the nexovue browser door: web vitals, JS errors, page views and sessions.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.dts.json",
    "typecheck": "tsc -b",
    "size": "node scripts/measure-size.js",
    "test": "vitest run && pnpm run build && pnpm run size"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
