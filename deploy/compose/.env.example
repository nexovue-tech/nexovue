# Development needs none of this: compose.infra.yaml carries dev defaults, so
# `just dev` works on a fresh clone with no setup.
#
# This file documents what the deployment targets require. They redeclare every
# credential with the `:?` form precisely so a dev default cannot leak into a
# real environment.
#
#   docker compose -f docker-compose.app.yaml --env-file .env up -d

# --- development: host port overrides ---
# Only needed when another project on the same machine already holds one of the
# well-known ports. The container side never moves, so nothing else changes.
# KAFKA_HOST_PORT=29092
# CLICKHOUSE_HTTP_HOST_PORT=8123
# CLICKHOUSE_NATIVE_HOST_PORT=9000
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# SEAWEEDFS_S3_HOST_PORT=8333
# SEAWEEDFS_MASTER_HOST_PORT=9333
# RECEIVER_GRPC_HOST_PORT=4317
# RECEIVER_HTTP_HOST_PORT=4318
# API_HOST_PORT=8000
# WEB_HOST_PORT=5173
# DEMO_APP_HOST_PORT=8090

# --- deployment targets ---
POSTGRES_DB=nexovue
POSTGRES_USER=nexovue
POSTGRES_PASSWORD=

CLICKHOUSE_DB=nexovue
CLICKHOUSE_USER=nexovue
CLICKHOUSE_PASSWORD=

# Any base64url-encoded 16-byte UUID. Generate once per cluster and never change
# it: the value is written into the KRaft metadata log on first boot.
KAFKA_CLUSTER_ID=

# Image tag for the built services. `dev` in the production replica; a release
# tag on-premise.
NEXOVUE_VERSION=dev

# --- on-premise only (docker-compose.onprem.yaml) ---
NEXOVUE_REGISTRY=
NEXOVUE_PUBLIC_HOST=
NEXOVUE_TLS_EMAIL=
NEXOVUE_S3_ENDPOINT=
KAFKA_HEAP_OPTS=-Xmx4g -Xms4g
