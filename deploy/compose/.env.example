# Development needs none of this: compose.infra.yaml carries dev defaults, so
# `just dev` works on a fresh clone with no setup.
#
# This file documents what the deployment targets require. They redeclare every
# credential with the `:?` form precisely so a dev default cannot leak into a
# real environment.
#
#   docker compose -f docker-compose.app.yaml --env-file .env up -d

# --- development: host port overrides ---
# Every host port lives in a nexovue-specific 1xxxx block so the stack cannot
# collide with another project's Postgres or Kafka. The container side never
# moves, so overriding one of these changes nothing but where you dial in.
# The values below ARE the defaults — uncomment only to move one.
#
# Kafka's advertised HOST listener follows KAFKA_HOST_PORT. It has to: a client
# bootstraps, is told where to reconnect, and hangs if that address is not the
# one actually published.
# KAFKA_HOST_PORT=19092
# CLICKHOUSE_HTTP_HOST_PORT=18123
# CLICKHOUSE_NATIVE_HOST_PORT=19000
# POSTGRES_HOST_PORT=15432
# SEAWEEDFS_S3_HOST_PORT=18333
# SEAWEEDFS_MASTER_HOST_PORT=19333
# RECEIVER_GRPC_HOST_PORT=14317
# RECEIVER_HTTP_HOST_PORT=14318
# API_HOST_PORT=18000
# WEB_HOST_PORT=15173
# DEMO_APP_HOST_PORT=18090
# DEMO_CHECKOUT_HOST_PORT=18091
# DEMO_PAYMENTS_HOST_PORT=18092
# OLLAMA_HOST_PORT=21434

# --- deployment targets ---
POSTGRES_DB=nexovue
POSTGRES_USER=nexovue
POSTGRES_PASSWORD=

CLICKHOUSE_DB=nexovue
CLICKHOUSE_USER=nexovue
CLICKHOUSE_PASSWORD=

# Any base64url-encoded 16-byte UUID. Generate once per cluster and never change
# it: the value is written into the KRaft metadata log on first boot.
KAFKA_CLUSTER_ID=

# Keys the pseudonyms a hashing masking rule produces. At least 32 bytes,
# base64: `openssl rand -base64 32`. Every worker replica must carry the same
# value, and rotating it silently ends every correlation spanning the change.
WORKERS_MASKING_HASH_SECRET=

# Image tag for the built services. `dev` in the production replica; a release
# tag on-premise.
NEXOVUE_VERSION=dev

# --- on-premise only (docker-compose.onprem.yaml) ---
NEXOVUE_REGISTRY=
NEXOVUE_APP_HOST=
# Where a customer points their OTLP exporter, as *they* reach it — not as we do.
# Signup returns this and the onboarding screen prints it, so leaving it unset in a
# deployed install hands every new account `http://localhost:14318`: their exporter
# posts to their own machine, nothing arrives, and no request reaches us to say so.
# Outside development the API now refuses to start rather than allow that.
OTLP_ENDPOINT=

NEXOVUE_INGEST_HOST=
NEXOVUE_TLS_EMAIL=
# Object storage for source map bytes (generic S3 API only).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
KAFKA_HEAP_OPTS=-Xmx4g -Xms4g
