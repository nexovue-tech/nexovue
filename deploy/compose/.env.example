# Development needs none of this: compose.infra.yaml carries dev defaults, so
# `just dev` works on a fresh clone with no setup.
#
# This file documents what the deployment targets require. They redeclare every
# credential with the `:?` form precisely so a dev default cannot leak into a
# real environment.
#
# A self-hosted install never needs this file: `deploy/nexovue install` writes its own settings
# (docs/self-hosting/install.md). It is the replica's: `just dev-app`.

# --- development: host port overrides ---
# Every host port lives in a nexovue-specific 1xxxx block so the stack cannot
# collide with another project's Postgres or Kafka. The container side never
# moves, so overriding one of these changes nothing but where you dial in.
# The values below ARE the defaults — uncomment only to move one.
#
# Kafka's advertised HOST listener follows KAFKA_HOST_PORT. It has to: a client
# bootstraps, is told where to reconnect, and hangs if that address is not the
# one actually published.
# KAFKA_HOST_PORT=19092
# CLICKHOUSE_HTTP_HOST_PORT=18123
# CLICKHOUSE_NATIVE_HOST_PORT=19000
# POSTGRES_HOST_PORT=15432
# SEAWEEDFS_S3_HOST_PORT=18333
# SEAWEEDFS_MASTER_HOST_PORT=19333
# RECEIVER_GRPC_HOST_PORT=14317
# RECEIVER_HTTP_HOST_PORT=14318
# API_HOST_PORT=18000
# WEB_HOST_PORT=15173
# DEMO_APP_HOST_PORT=18090
# DEMO_CHECKOUT_HOST_PORT=18091
# DEMO_PAYMENTS_HOST_PORT=18092
# OLLAMA_HOST_PORT=21434

# --- deployment targets: both files ---
# `just dev-app` reads `deploy/compose/.env.replica`; copy this file there and
# fill it in. Not `deploy/compose/.env`: Compose reads that one by itself for every
# file in this directory, the dev stack included.
POSTGRES_DB=nexovue
POSTGRES_USER=nexovue
POSTGRES_PASSWORD=

CLICKHOUSE_DB=nexovue
CLICKHOUSE_USER=nexovue
CLICKHOUSE_PASSWORD=
# The account the API and the alert sweeps read with (users.d/reader.xml), the
# one the nightly erasure deletes with (users.d/eraser.xml), and the one anomaly
# detection writes its readings with (users.d/detection-writer.xml).
CLICKHOUSE_READER_PASSWORD=
CLICKHOUSE_ERASER_PASSWORD=
CLICKHOUSE_DETECTION_WRITER_PASSWORD=

# Any base64url-encoded 16-byte UUID. Generate once per cluster and never change
# it: the value is written into the KRaft metadata log on first boot.
KAFKA_CLUSTER_ID=

# Keys the pseudonyms a hashing masking rule produces. At least 32 bytes,
# base64: `openssl rand -base64 32`. Every worker replica must carry the same
# value, and rotating it silently ends every correlation spanning the change.
WORKERS_MASKING_HASH_SECRET=

# Seal check and channel secrets, and two-factor secrets. Production refuses to
# start without either; rotating them: docs/operations/key-rotation.md.
#   uv run python -c "from nexovue_platform.checks.sealing import generate_key; print(generate_key())"
CHECK_SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# Object storage for source maps and check files (generic S3 API only). The
# replica uses its own SeaweedFS and ignores S3_ENDPOINT.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The edge's two names (deploy/caddy/Caddyfile). Every public URL is built from
# them — the address signup hands a customer to export to is
# https://$NEXOVUE_INGEST_HOST, every emailed link https://$NEXOVUE_APP_HOST.
# On a laptop: app.localhost and ingest.localhost, which Caddy certifies from
# its own local authority.
NEXOVUE_APP_HOST=
NEXOVUE_INGEST_HOST=
# Where the certificate authority writes about expiring certificates.
NEXOVUE_TLS_EMAIL=

# How many copies of the API and the receiver run. Each copy enforces its share
# of the rate limits, so this one number sets both.
API_INSTANCES=1
RECEIVER_INSTANCES=1

# Image tag for the built services: `dev` in the production replica.
NEXOVUE_VERSION=dev

# The replica is the hosted layout, where customers arrive through signup; set these to seed an
# owner to sign in as (docs/operations/first-accounts.md).
FIRST_OWNER_EMAIL=
FIRST_OWNER_PASSWORD=
