# TLS edge for the on-premise deployment. SKELETON — see the TODOs.
#
# Caddy obtains and renews certificates on its own as long as it knows a
# hostname and the host answers on 80 and 443.

{
	email {$NEXOVUE_TLS_EMAIL}
}

# Two names, decided 2026-09-07: `app.nexovue.com` and `ingest.nexovue.com`.
# Ingest is machine traffic at high volume; the app is browser traffic, and they
# want different rate limits, different logs and a CSP that means nothing on the
# OTLP path. ADR 0089 makes it a privacy requirement rather than a preference:
# the ingest host must not share a cookie domain with the console.
#
# **Two names are necessary and not sufficient.** The session cookie must stay
# host-only — `auth/cookies.py` sets no Domain attribute, deliberately — because
# a cookie scoped to `.nexovue.com` reaches every child, including this one.
{$NEXOVUE_PUBLIC_HOST} {
	# OTLP: the receiver speaks the protocol's own error semantics, so nothing
	# here may rewrite a response body.
	handle /v1/* {
		reverse_proxy receiver:4318
	}

	# The browser door, on its own prefix so no route can resolve both a secret
	# and a public key. Without this the path falls through to `web` and a page
	# gets HTML back from an export.
	handle /browser/v1/* {
		reverse_proxy receiver:4318
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:8080
	}
}

# TODO(grpc): OTLP/gRPC on 4317 (P1-19) terminates TLS separately — h2c through
# Caddy needs its own site block and a decision on whether gRPC gets its own
# port or is multiplexed on 443.
