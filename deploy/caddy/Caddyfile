# The TLS edge of every deployed install: the hosted replica and on-premise.
#
# Caddy obtains and renews certificates on its own as long as it knows a
# hostname and the host answers on 80 and 443.
{
	email {$NEXOVUE_TLS_EMAIL}
}

# ---------------------------------------------------------------------------
# Response headers
#
# Two snippets, not one block copied twice: the console is browser traffic and
# ingest is machine traffic, and several of the console's headers are actively
# wrong on the OTLP path. `Cross-Origin-Resource-Policy: same-origin` is the
# clearest case — door 3 exports from the customer's own page, so same-origin
# would refuse the traffic ingest exists to accept.
# ---------------------------------------------------------------------------

# Everything both hosts send. HSTS belongs on ingest too: the browser SDK's
# `endpoint` is a public string in a customer's page, and this is what stops a
# mistyped `http://` one from ever leaving in the clear.
(edge_headers) {
	header {
		# Two years, per the OWASP Secure Headers Project. No `preload`: that
		# list is close to irreversible and needs the apex, which is not ours
		# to commit on a domain that has never served a request.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}

	# Deletions get their own block on purpose. A deletion makes the whole block
	# deferred, and a deferred block is skipped when an upstream fails — so
	# sharing one would drop HSTS from every 502. Losing only these there is
	# harmless: they hide which proxy answered, nothing more. `Via` goes with
	# `Server` because reverse_proxy sets it to `1.1 Caddy`, which would name
	# the thing the line above just stopped naming.
	header {
		-Server
		-Via
	}
}

# The console only. Every value here assumes a browser is rendering a document,
# which nothing on the ingest host ever does.
(console_headers) {
	import edge_headers

	header {
		# Console URLs carry trace and service identifiers, so no referrer
		# leaves at all. The app loads no cross-origin subresource that needs one.
		Referrer-Policy "no-referrer"

		# frame-ancestors is the one that modern browsers obey; X-Frame-Options
		# is kept for the ones that do not read CSP.
		X-Frame-Options "DENY"

		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"

		# Sensors, capture devices and payment: the console uses none of them.
		# Deliberately absent so they keep their `self` default: clipboard-write
		# (shared/components/CopyButton.tsx) and publickey-credentials-get,
		# which would have to be reopened the day login grows a passkey.
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"

		# Checked against apps/web, not assumed. The app itself loads no external
		# origin — fonts are vendored into @nexovue/ui and bundled — so
		# `default-src 'self'` covers images, fonts, styles and scripts. The one
		# exception is the payment checkout, below.
		#
		# script-src: the hash is the theme bootstrap in apps/web/index.html,
		# which must run before first paint and so cannot be moved to a file.
		# `apps/api/tests/test_caddyfile_headers.py` fails if the two drift.
		#
		# connect-src: the log tail is a same-origin WebSocket, and `'self'`
		# is documented as not resolving to `wss:` in every browser, so the
		# origin is spelled out.
		#
		# {$NEXOVUE_CHECKOUT_ORIGINS}: the payment processor's checkout, which loads
		# its script, opens its frame and calls home from its own origins. Set on the
		# hosted file, empty on a self-hosted install, which takes no payments.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-l0ccwCCCCbd6qE6AXzKsNeUubznvX4TgnnF7fn9ilzs=' {$NEXOVUE_CHECKOUT_ORIGINS}; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://{$NEXOVUE_APP_HOST} {$NEXOVUE_CHECKOUT_ORIGINS}; frame-src 'self' {$NEXOVUE_CHECKOUT_ORIGINS}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# `style-src 'self'` is the one directive above that was reasoned about
		# rather than watched. React and uPlot position elements through the
		# CSSOM, which CSP does not govern, so this should report nothing —
		# but no browser had loaded the console under it. Loaded on 2026-10-11:
		# the console itself reports nothing, and Razorpay's checkout script
		# injects inline styles into the page — so 'unsafe-inline' stays while
		# the hosted console takes payments.
		Content-Security-Policy-Report-Only "style-src 'self'"
	}
}

# ---------------------------------------------------------------------------
# Sites
#
# Two names, decided 2026-09-07. Ingest is machine traffic at high volume; the
# console is browser traffic, and they want different rate limits, different
# logs and a CSP that means nothing on the OTLP path. Session-cookie isolation
# makes it a privacy requirement rather than a preference: the ingest host must
# not share a cookie domain with the console.
#
# **Two names are necessary and not sufficient.** The session cookie must stay
# host-only — `auth/cookies.py` sets no Domain attribute, deliberately —
# because a cookie scoped to `.nexovue.com` reaches every child, including this
# one.
# ---------------------------------------------------------------------------

{$NEXOVUE_APP_HOST} {
	import console_headers

	# The API's largest legitimate body is a source map: 64 MiB and its form
	# fields. No more than that is ever forwarded; the API refuses a declared
	# oversize before reading it and holds each route to its own, smaller cap
	# (`middleware/body_limit.py`). `test_caddyfile_headers.py` fails if this
	# falls below the API's largest.
	handle /api/* {
		request_body {
			max_size 65MiB
		}
		# `dynamic a`, not `api:8000`: a static name is resolved to one address and
		# kept, so every request would go to the first of several API replicas.
		reverse_proxy {
			dynamic a api 8000 {
				refresh 5s
			}
		}
	}

	# The console is static files (ADR-019 point 3), copied into this volume at
	# deploy time by `web-assets-init`. A hashed asset never changes under its name,
	# so it is cached for a year — but only when it exists, so a 404 is never
	# remembered.
	handle /assets/* {
		root * /srv/web
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the page itself, whose path the console's router owns.
	# `no-cache` makes a browser ask before reusing it: a remembered index.html
	# names assets a deploy has removed, and the console renders blank.
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$NEXOVUE_INGEST_HOST} {
	import edge_headers

	# OTLP: the receiver speaks the protocol's own error semantics, so nothing
	# here may rewrite a response body. The receiver also owns CORS for door 3
	# — the edge must not answer a preflight on its behalf.
	handle /v1/* {
		reverse_proxy {
			dynamic a receiver 4318 {
				refresh 5s
			}
		}
	}

	# The browser door, on its own prefix so no route can resolve both a secret
	# and a public key.
	handle /browser/v1/* {
		reverse_proxy {
			dynamic a receiver 4318 {
				refresh 5s
			}
		}
	}

	# Anything else on this name is a misconfigured exporter. Say so, rather
	# than letting Caddy answer an empty 200 that reads as success.
	handle {
		respond 404
	}
}

