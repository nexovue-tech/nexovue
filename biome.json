{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!**/node_modules",
      "!**/dist",
      "!**/.venv",
      "!packages/contracts/gen",
      "!tools/otel-demo/upstream",
      "!**/*.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error"]
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "axios": "Use the fetch-based client in shared/api-client.ts. axios is not a dependency of this project."
                },
                "patterns": [
                  {
                    "group": ["@/features/**"],
                    "message": "features must not import each other. Move the shared thing to shared/, or compose both features in app/."
                  },
                  {
                    "group": ["../**"],
                    "message": "a relative path that leaves a feature directory evades the two rules below, because those match the import string and \"../services/thing\" contains neither \"features/\" nor an alias. Feature directories are flat, so \"../\" always escapes one. Use @/shared/, or move the shared thing there."
                  },
                  {
                    "group": ["**/app/**", "@/app/**"],
                    "message": "features must not import from app/. Imports flow shared -> features -> app; compose features at the app layer."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**", "!apps/web/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "axios": "Use the fetch-based client in shared/api-client.ts. axios is not a dependency of this project."
                }
              }
            }
          }
        }
      }
    }
  ]
}
