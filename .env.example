# nexovue — every environment variable any service reads.
#
# Copy to `.env` and edit. `.env` is gitignored; this file is the documentation
# of what a service needs, so a variable that is not here does not exist.
#
# Rules that hold for every service:
#   * a variable with no default here is REQUIRED — the service exits at boot,
#     naming the variable, rather than starting with a wrong value;
#   * nothing carrying a credential has a default in code;
#   * the three shared infrastructure variables use the same name everywhere:
#     KAFKA_BROKERS, POSTGRES_DSN, CLICKHOUSE_DSN.
#
# The values below point at the local compose stack.


# ==========================================================================
# Every service
# ==========================================================================

# REQUIRED. development | staging | production
ENV=development

# debug | info | warn | error.  ERROR needs a human · WARN degraded but handled
# · INFO a state change · DEBUG development detail.
LOG_LEVEL=debug

# json | console.  Production ships json; console is for reading a terminal.
LOG_FORMAT=console

# How long a service gets to drain in-flight work after SIGTERM. Go services.
SHUTDOWN_TIMEOUT=20s


# ==========================================================================
# Shared infrastructure
# ==========================================================================

# REQUIRED wherever it appears. Comma-separated host:port list.
KAFKA_BROKERS=localhost:29092

# REQUIRED. Plain postgresql:// — each service adds the driver it needs, so one
# value works for the API, the scheduler and the Go services alike.
POSTGRES_DSN=postgresql://nexovue:nexovue_dev@localhost:15432/nexovue

# REQUIRED for the workers and the API. Same variable, same scheme — but
# ClickHouse serves two protocols on two ports, so the PORT differs by service:
#   workers (native protocol, ch-go):        port 9000
#   api     (HTTP protocol, clickhouse-connect): port 8123
# Use clickhouses:// (or ?secure=true) for TLS.
CLICKHOUSE_DSN=clickhouse://nexovue:nexovue_dev@localhost:19000/nexovue


# ==========================================================================
# receiver  (Go — the ingestion edge)
# ==========================================================================
# Reads: ENV, LOG_*, KAFKA_BROKERS, POSTGRES_DSN, SHUTDOWN_TIMEOUT.

# OTLP/HTTP listener. Bound by the OTLP endpoint (P1-12).
RECEIVER_OTLP_HTTP_ADDR=:4318

# Probe listener. Separate from the data port on purpose, so /healthz and
# /readyz still answer when the OTLP port is saturated.
RECEIVER_HEALTH_ADDR=:8081

# How long past its cache TTL a key seen valid keeps working while Postgres
# cannot answer, so a short control-plane outage is not an ingest outage. It is
# also how long an outage extends a revoked key's life. Zero refuses at once.
RECEIVER_API_KEY_MAX_STALE=10m


# ==========================================================================
# workers  (Go — trace-assembler, log-writer, metrics-deriver, edge-aggregator)
# ==========================================================================
# Reads: ENV, LOG_*, KAFKA_BROKERS, CLICKHOUSE_DSN, SHUTDOWN_TIMEOUT.
# All four binaries share one settings surface; each runs in its own container,
# so they can all use the same probe port.

WORKERS_HEALTH_ADDR=:8081

# Set explicitly rather than left to the library default, which is one
# connection per CPU and so differs on every machine.
CLICKHOUSE_MAX_CONNS=4


# ==========================================================================
# api  (Python — FastAPI control plane)
# ==========================================================================
# Reads: ENV, LOG_*, POSTGRES_DSN, CLICKHOUSE_DSN (HTTP port).
# NOTE: for the API, CLICKHOUSE_DSN must name the HTTP port:
#   CLICKHOUSE_DSN=clickhouse://nexovue:nexovue_dev@localhost:18123/nexovue

# Postgres pool, sized here and never left to the library default.
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT_SECONDS=10
POSTGRES_POOL_RECYCLE_SECONDS=1800

# ClickHouse pool, and the row guard applied to every query. Every read is held
# to 30 seconds by the reader account itself; there is no setting for it.
CLICKHOUSE_POOL_SIZE=8
CLICKHOUSE_MAX_RESULT_ROWS=100000

# Session lifetime, fixed when a session is made (`sessions.expires_at`).
SESSION_TTL_SECONDS=604800

# Rate limiting. Turn off only in a test harness.
RATE_LIMIT_ENABLED=true
# How many API processes share the traffic; each enforces its share of every
# in-memory limit. The auth tier is counted in Postgres and is not divided.
API_INSTANCES=1

# How many proxies sit in front of the API. Zero means X-Forwarded-For is a
# value the client chose, so the direct peer is used as the client address.
# Set this to the real number of hops when running behind a load balancer.
#
# Zero is right for local development, where nothing is in front of the API.
# It is wrong behind a proxy, and quietly so: the direct peer is then the
# proxy for every request, so all callers share one rate-limit bucket and ten
# failed logins a minute lock out everyone. The on-premise compose sets 1 for
# its Caddy hop.
TRUSTED_PROXY_COUNT=0

# JSON array. Empty means no browser origin is allowed to call the API.
CORS_ALLOWED_ORIGINS=["http://localhost:15173"]

# Stamped by the image build. Without them the API reports the git checkout.
# BUILD_REVISION=
# BUILD_TIME=


# ==========================================================================
# encryption keys  (API and scheduler; docs/operations/key-rotation.md)
# ==========================================================================
# Each is 32 random bytes, URL-safe base64. Generate one with:
#   uv run python -c "from nexovue_platform.checks.sealing import generate_key; print(generate_key())"
# Optional in development (the routes that need one answer 503); production
# refuses to start without them.

# Seals check secrets and alert-channel secrets. The API and the scheduler hold
# the same value.
CHECK_SECRET_KEY=
# Seals two-factor (TOTP) secrets. The API alone.
CREDENTIAL_ENCRYPTION_KEY=

# During a rotation only: the keys that sealed before the current one,
# comma-separated. They open and never seal. Emptied once `just keys-status`
# shows nothing left under them.
CHECK_SECRET_PREVIOUS_KEYS=
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=


# ==========================================================================
# scheduler  (Python — doors 2 and 4b: beat and the workers of its job queue)
# ==========================================================================
# Reads: ENV, LOG_*, POSTGRES_DSN, KAFKA_BROKERS.
# Jobs are rows in Postgres; every job carries its own soft and hard time limit.

# Erasing deleted organizations' telemetry and files, once a night (ADR-014).
# The one ClickHouse credential that can delete; the API holds none. The account
# can read and delete and nothing else (deploy/clickhouse/users.d/eraser.xml).
# Empty means nothing is erased, and the scheduler logs that at ERROR every hour.
CLICKHOUSE_ERASER_DSN=clickhouse://nexovue_eraser:nexovue_eraser_dev@localhost:18123/nexovue
# The UTC hour it runs in (0-23), and the most organizations one group names.
ERASURE_HOUR_UTC=2
ERASURE_BATCH_SIZE=100

# Anomaly detection (F6, ADR-023) freezes each judged minute in ClickHouse. The
# account can insert into detection_readings and nothing else
# (deploy/clickhouse/users.d/detection-writer.xml). Empty means detection judges
# nothing, and the scheduler logs that at ERROR on every pass.
CLICKHOUSE_DETECTION_WRITER_DSN=clickhouse://nexovue_detection_writer:nexovue_detection_writer_dev@localhost:18123/nexovue

# Where each scheduler process answers /healthz, /readyz and /metrics (ADR-021).
# Internal: no edge routes it. The compose healthcheck runs
# `python -m nexovue_scheduler health`, which asks this port.
HEALTH_ADDR=:8081


# ==========================================================================
# email  (P1-69 — verification, password reset, invoices)
# ==========================================================================
# The provider is not named here, deliberately. A vendor's vocabulary is kept
# out of the port; a vendor's name in a config key is the same leak in a
# different file, and the key's own prefix already says which one it is.
#
# The whole volume is verification, reset and invoices — tens of messages a
# month, against a free tier of thousands. What matters is that each one
# arrives, not how many there are.

# Which implementation sends. The vendor's name is the *value*, never the key —
# every other EMAIL_* variable survives a switch, which is the point. An unknown
# value fails at start-up rather than at the first send.
# `console` writes each message to the log and sends nothing; production refuses
# it. Blank or unset means mail is not configured, which production allows.
EMAIL_PROVIDER=resend

# From the provider's dashboard. Never committed: `.env` is gitignored.
EMAIL_API_KEY=

# The domain whose SPF, DKIM and DMARC records were verified. Mail can only be
# sent from this domain, which is why it is not the same as the address a
# person writes to.
EMAIL_SENDING_DOMAIN=mail.nexovue.com

# What a recipient sees. Must be at EMAIL_SENDING_DOMAIN or the provider
# refuses it.
EMAIL_FROM_ADDRESS=noreply@mail.nexovue.com

# Where a reply goes, which is a real inbox rather than the sending domain.
# Without it a customer who replies is talking to nobody.
EMAIL_REPLY_TO=nexovue@nexovue.com

# Where a verification or password-reset link points. The customer-facing app,
# never this API: the link is opened in a browser and lands on a screen, which
# then calls the endpoint behind it. In dev that is the Vite server; in
# production it is the app hostname, not the ingest one.
APP_BASE_URL=http://localhost:15173

# How long each link lives. A verification link is followed at leisure; a reset
# link is a live credential to somebody's account, so it is short.
VERIFY_EMAIL_TTL_SECONDS=86400
RESET_PASSWORD_TTL_SECONDS=3600


# ==========================================================================
# payments  (P1-73 — sandbox credentials only)
# ==========================================================================
# Named for the role rather than the processor: the likely end state is two of
# these — a domestic gateway for India and a merchant of record for everywhere
# else, because a non-EU seller owes EU VAT from the first euro. A key called
# after one of them describes half a system.
#
# All of APP_ID, SECRET_KEY and BASE_URL, or none: with any of them unset the
# API serves every screen and refuses the billing webhook by variable name,
# rather than failing later with a signature mismatch nobody can debug.
#
# The webhook lands on POST /api/v1/billing/webhook/domestic, and the URL is
# what you register in the processor's dashboard. The path names the role, not
# the vendor, so the second processor gets its own.

# **`just dev` reads this file into the API container**, and it is the only place
# these can come from: every other value in the dev compose is a constant, because
# the Postgres and SeaweedFS passwords there mean nothing outside your machine.
# A sandbox gateway account belongs to a person, so it lives here.
#
# Leave them blank and the stack still comes up. `Settings.domestic_payments`
# reads blank as "not configured", the billing screen says upgrading is
# unavailable rather than drawing a form that would fail, and nothing on the
# walking-skeleton path needs a gateway at all.
#
# Which domestic gateway. Named for the role because a second one is expected
# — a merchant of record for international customers, since a non-EU seller
# owes EU VAT from the first euro and a domestic gateway does not carry it.
PAYMENTS_DOMESTIC_PROVIDER=razorpay

# The key id. **It decides test or live**: `rzp_test_…` writes to the test books
# and takes no money, `rzp_live_…` debits real cards. The API refuses to start
# with a test key when ENV=production, and with a live key anywhere else. A live
# key needs the provider's KYC and website verification, which wants live terms,
# privacy and refund pages — that is the real lead time.
PAYMENTS_DOMESTIC_APP_ID=

# The API credential, and *only* that. It does not sign webhooks — see
# PAYMENTS_DOMESTIC_WEBHOOK_SECRET below.
PAYMENTS_DOMESTIC_SECRET_KEY=

# What a delivery's signature is checked against. **Not the API secret**: this
# processor signs with a secret you invent when creating the webhook in its
# dashboard, and it is never shown again afterwards. Left empty this falls back
# to the API secret, which refuses every genuine delivery with a message that
# reads like a forgery — a subscription then sits on `pending` forever with
# nothing visibly wrong. `openssl rand -hex 32` generates one.
#
# The dashboard keeps *separate* webhooks for test and live mode. A webhook
# added in the wrong mode never fires and reports no error anywhere.
# Which currencies this account may actually charge in — comma separated,
# e.g. "INR" or "INR,USD". Not a property of the gateway but of the arrangement
# with it: an Indian account takes rupees from the day it opens and dollars only
# once the provider approves international payments, which is applied for and
# waited on.
#
# Leave it empty and every priced currency is offered, which is right for a
# deployment that has no restriction. Set it and the billing screen stops
# offering what the account would refuse — a customer otherwise reaches the last
# button before being turned away.
PAYMENTS_DOMESTIC_CURRENCIES=INR

PAYMENTS_DOMESTIC_WEBHOOK_SECRET=

# Derived from the provider when empty, which is what
# it should normally be. Set it only for a test transport or a regional host.
PAYMENTS_DOMESTIC_BASE_URL=
